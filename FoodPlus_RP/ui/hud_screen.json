              "controls": [
                {
                  "saturation_factory_non_centered@foodplus.saturation_factory_non_centered": {}
                }
              ],
              "bindings": [
                {
                  "binding_name": "#show_survival_ui",
                  "binding_name_override": "#visible"
                }
              ]
            }
          }
        ]
      }
    ]
  },
